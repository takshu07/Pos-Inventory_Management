# =============================================================================
# SERVER ENVIRONMENT — template. Copy to `.env` and fill in real values.
# =============================================================================

# PostgreSQL connection string (REQUIRED)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Secret for signing JWT access tokens (REQUIRED)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Server
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="debug"

# Comma-separated allowed frontend origins (Vite dev defaults to 5173)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# =============================================================================
# OFFLINE-FIRST  (docs/OFFLINE_FIRST.md)
#
# ⚠ LEAVE THIS DISABLED. It is off until the operational validation in
# MODULE_STATUS §0.4 is signed off, and a test asserts this file does not
# enable it — .env.example is what gets copied when a new server is stood up,
# so a stray "true" here reaches production by way of someone following the
# setup instructions correctly.
#
# With OFFLINE_MODE_ENABLED unset, none of the variables below are read, no
# SQLite file is opened, and the server behaves exactly as it did before the
# feature existed.
# =============================================================================

OFFLINE_MODE_ENABLED="false"

# "cloud" = the central Neon-backed server (serves /sync/download and /sync/upload)
# "edge"  = an in-store node that operates on local SQLite and syncs up
OFFLINE_ROLE="cloud"

# ── Edge nodes only ──────────────────────────────────────────────────────────
# ⚠ OFFLINE_DEVICE_ID must be UNIQUE PER TILL. It namespaces every idempotency
# key; two stores sharing one would make the cloud discard one store's sales as
# duplicates.
OFFLINE_DEVICE_ID=""
SYNC_CLOUD_URL=""
LOCAL_DATABASE_PATH="./data/pos-local.db"

# ── Both roles ───────────────────────────────────────────────────────────────
# Shared secret used to sign sync requests (edge) and verify them (cloud).
# Minimum 32 characters — it is the only credential protecting /sync/upload.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SYNC_DEVICE_SECRET=""
