  isActive            Boolean      @default(true)
  lastLogin           DateTime?
  // Incremented on every password change or explicit "logout all devices" action.
  // Access tokens carry this version; a mismatch means the token is invalidated
  // without storing individual refresh tokens in the database.
  refreshTokenVersion Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // ── Workforce Management extensions ────────────────────────────────────────
  // Added by the Workforce module. Every field is nullable/defaulted so existing
  // rows and every existing query keep working untouched.

  /// Profile photo. Stored as an Asset id or URL — the Asset engine owns bytes.
